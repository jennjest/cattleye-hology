# =============================================================================
# CATTLEYE - container runtime environment
#
#   cp .env.docker.example .env.docker
#   openssl rand -base64 32   # -> APP_KEY
#   openssl rand -base64 24   # -> DB_PASSWORD / DB_ROOT_PASSWORD
#   openssl rand -hex 32      # -> CATTLEYE_DEVICE_TOKEN
#
# Then run every compose command with the explicit env file so interpolation
# resolves the same values the containers receive:
#
#   docker compose --env-file .env.docker up -d --build
#
# .env.docker is gitignored and excluded from the build context.
# =============================================================================

WEB_PORT=8080

# --- Application ------------------------------------------------------------
APP_NAME=CATTLEYE
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.92.63:8080

APP_KEY=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# --- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=user
DB_USERNAME=user
DB_PASSWORD=

# Consumed by the mariadb entrypoint only.
MARIADB_DATABASE=user
MARIADB_USER=user
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --- Session / queue / cache ------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=cattleye@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- CATTLEYE device integration --------------------------------------------
# Required. Empty means the Pi ingest endpoints answer 503.
# Generate with: php artisan cattleye:token
CATTLEYE_DEVICE_TOKEN=

# The Raspberry Pi FastAPI app. Must be reachable FROM the container, so a
# plain 192.168.x.x only works when the host routes to that LAN. Once Tailscale
# is up, use the Pi's tailnet address instead.
CATTLEYE_EDGE_URL=http://192.168.1.212:8000
CATTLEYE_EDGE_TIMEOUT=5
CATTLEYE_EDGE_CACHE_SECONDS=10

# log | telegram | whatsapp
CATTLEYE_NOTIFY_DRIVER=log
CATTLEYE_ALERT_STATUS=Berisiko Tinggi
CATTLEYE_ALERT_COOLDOWN_MINUTES=30

# Required when CATTLEYE_NOTIFY_DRIVER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required when CATTLEYE_NOTIFY_DRIVER=whatsapp
CATTLEYE_WHATSAPP_WEBHOOK_URL=
CATTLEYE_WHATSAPP_RECIPIENT=

VITE_APP_NAME="${APP_NAME}"
