APP_NAME=CATTLEYE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Shared secret for device ingest endpoints. Generate with: php artisan cattleye:token
# Leave empty to disable ingestion (requests fail with 503).
CATTLEYE_DEVICE_TOKEN=

# Where the Raspberry Pi serves its FastAPI app. Used by the live camera panel.
# Leave CATTLEYE_EDGE_URL empty to hide the panel instead of showing a dead stream.
CATTLEYE_EDGE_URL=http://192.168.1.212:8000
CATTLEYE_EDGE_TIMEOUT=5
CATTLEYE_EDGE_CACHE_SECONDS=10

# Risk alerts. Driver: log | telegram | whatsapp.
# "log" records the alert to storage/logs/cattleye-*.log and needs no credentials,
# so a fresh install never silently drops a sick cow.
CATTLEYE_NOTIFY_DRIVER=log
# Only this status or worse raises an alert: Waspada | Berisiko Tinggi
CATTLEYE_ALERT_STATUS="Berisiko Tinggi"
# How long a cow may keep alarming before the alert is repeated. A recovery notice
# is always delivered and re-arms the alert immediately.
CATTLEYE_ALERT_COOLDOWN_MINUTES=30

# Telegram Bot API. Required when CATTLEYE_NOTIFY_DRIVER=telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp gateway webhook, expected to accept {"message": "...", "to": "..."}.
# Required when CATTLEYE_NOTIFY_DRIVER=whatsapp.
CATTLEYE_WHATSAPP_WEBHOOK_URL=
CATTLEYE_WHATSAPP_RECIPIENT=

VITE_APP_NAME="${APP_NAME}"
