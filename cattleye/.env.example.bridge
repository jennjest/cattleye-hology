# Konfigurasi cattleye/bridge_to_laravel.py
# Salin ke .env lalu isi token dari server: php artisan cattleye:token

# Alamat FastAPI milik Pi itu sendiri (dijalankan dari Pi).
CATTLEYE_PI_URL=http://127.0.0.1:8000

# Alamat server Laravel. Boleh http://192.168.1.10:8000 atau domain.
CATTLEYE_SERVER_URL=http://192.168.1.10:8000

# Shared secret device. WAJIB diisi, jangan commit nilai aslinya.
CATTLEYE_DEVICE_TOKEN=

# Kode sapi yang dilaporkan skrip ini (harus ada di tabel cows pada server).
CATTLEYE_COW_CODE=cow01

# Seberapa sering snapshot dikirim ke server.
CATTLEYE_BRIDGE_INTERVAL_SEC=2
