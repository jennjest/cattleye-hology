# Konfigurasi environment Raspberry Pi untuk CATTLEYE.
# Salin ke .env di folder cattleye/ lalu isi nilainya. Jangan commit .env.

# ---------------------------------------------------------------
# Token device
# ---------------------------------------------------------------
# Shared secret yang sama dengan bridge_to_laravel.py. Ambil dari server:
#   php artisan cattleye:token
# Kosongkan hanya untuk mencoba fusion di laptop; settings_sync lalu menonaktifkan
# polling himself dan Pi berjalan dengan DEFAULT_SETTINGS.
CATTLEYE_DEVICE_TOKEN=

# ---------------------------------------------------------------
# Alamat server Laravel
# ---------------------------------------------------------------
# Dipakai settings_sync.py untuk menarik ambang fusion. Boleh IP jaringan lokal atau domain.
CATTLEYE_SERVER_URL=http://127.0.0.1:8000

# Seberapa sering ambang fusion ditarik. Operator mengubahnya lewat browser,
# jadi polling lambat sudah cukup. Nilai lebih kecil dari 15 detik tidak berguna
# karena HTTP round-trip ke server sudah memakan waktu.
CATTLEYE_SETTINGS_POLL_SECONDS=60

# ---------------------------------------------------------------
# Alamat perangkat keras
# ---------------------------------------------------------------
# Endpoint stream JPEG dari ESP32-CAM. Ganti dengan IP aktual di lapangan.
ESP32CAM_URL=http://192.168.1.127:81/stream

# Kode sapi yang dilaporkan ke server (harus ada di tabel cows).
CATTLEYE_COW_CODE=cow01
